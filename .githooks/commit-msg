#!/usr/bin/env bash
set -e

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?: .+"

if ! [[ "$COMMIT_MSG" =~ $PATTERN ]]; then
    echo "❌ [Git Hook] Mensagem de commit fora do padrão Conventional Commits!"
    echo "Formato esperado: <tipo>(<escopo opcional>): <descrição>"
    echo "Tipos válidos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo "Exemplo: feat(cli): add version command"
    exit 1
fi
